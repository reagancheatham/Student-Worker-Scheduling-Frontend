{
    "compilerOptions": {
        "moduleResolution": "bundler",
        "allowImportingTsExtensions": true,
        "noEmit": true,
        "target": "esnext",
        "module": "esnext",
        "types": ["vite/client"],
        "paths": {
            "@components/*": ["./src/components/*"],
            "@classes/*": ["./src/classes/*"]
        }
    },
    "include": [
        "src/**/*.ts",
        "src/**/*.tsx",
        "src/**/*.vue",
        "auto-imports.d.ts",
        "components.d.ts",
        "tailwind.config.ts"
    ]
}
